# Copy this to .env and fill in your real values, then restart the Metro
# bundler (env vars are read at build time, not live-reloaded).
# All three are public/client-safe values (anon key, not service_role; no
# secrets live in this file), but keep .env out of version control anyway.

EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_POWERSYNC_URL=https://YOUR-INSTANCE.powersync.journeyapps.com
# Optional until the FastAPI service is deployed. Required for the settlement screen.
EXPO_PUBLIC_API_URL=http://YOUR-API-HOST:8000
