# Copy this to .env and fill in your real values — .env is gitignored.
# All three are public/client-safe values (anon key, not service_role; no
# secrets live in this file), but keep .env out of version control anyway.

VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_POWERSYNC_URL=https://YOUR-INSTANCE.powersync.journeyapps.com
