# Copy this to .env and fill in your real values, then restart the Metro
# bundler (env vars are read at build time, not live-reloaded).
# Keep .env out of version control — real keys must never be committed.
#
# All EXPO_PUBLIC_* values are bundled into the app binary and are visible to
# anyone who extracts the bundle. Only client-safe values belong here:
#   ✓  EXPO_PUBLIC_SUPABASE_ANON_KEY  (anon/publishable key, not service_role)
#   ✓  EXPO_PUBLIC_POWERSYNC_URL
#   ✓  EXPO_PUBLIC_API_URL
#   ✗  SUPABASE_SERVICE_ROLE_KEY      → server only, never here
#   ✗  DATABASE_URL                   → server only (services/api/.env)
#   ✗  SUPABASE_JWKS_URL              → server only (services/api/.env)

# ── Supabase ──────────────────────────────────────────────────────────────────
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Found in Supabase Dashboard → Settings → API → Project API keys (anon/public)
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ── PowerSync ─────────────────────────────────────────────────────────────────
EXPO_PUBLIC_POWERSYNC_URL=https://YOUR-INSTANCE.powersync.journeyapps.com

# ── FastAPI settlement service ────────────────────────────────────────────────
# Required for the Settle tab (SettlementView.tsx). Use localhost:8000 for local dev.
EXPO_PUBLIC_API_URL=http://YOUR-API-HOST:8000
