# Expensio FastAPI service — environment variables
# Copy this to .env (ignored by git) and fill in real values before running locally.
# In production, inject these as secrets via your deployment environment — never commit
# real values to the repository.
#
# See services/api/README.md for the local run command.

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres connection string for a LEAST-PRIVILEGED role — read-only access to
# trip_members, trip_balances, and participants is sufficient. Never use the
# Supabase service_role / postgres superuser connection string here.
# Transaction-mode pooler URL from Supabase Dashboard → Settings → Database → Connection string
DATABASE_URL=postgresql://YOUR-ROLE:YOUR-PASSWORD@YOUR-HOST:6543/postgres

# ── Supabase JWT verification ──────────────────────────────────────────────────
# Found at: https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWKS_URL=https://YOUR-PROJECT-REF.supabase.co/auth/v1/.well-known/jwks.json

# Issuer claim in Supabase JWTs — typically the auth service URL.
# Found in Supabase Dashboard → Settings → API → JWT Settings → JWT issuer
# Usually: https://YOUR-PROJECT-REF.supabase.co/auth/v1
# Leave blank to skip issuer validation (acceptable for local dev, not production).
SUPABASE_JWT_ISSUER=https://YOUR-PROJECT-REF.supabase.co/auth/v1
